# Runtime konfiguracija na ZimaOS-u: /DATA/AppData/campaign-companion/config/app.env
# Datoteka ostaje SAMO na serveru (chmod 600). Nikad u Git, nikad u GitHub Secrets.
# DATABASE_URL i BACKUP_DIR postavlja compose.yaml.

# AI provider (Faza 5): openai | anthropic | none
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=

# Autentifikacija i sesije (prije mobilnog pristupa, vidi ADR-0002)
SESSION_SECRET=
APP_ORIGIN=https://campaign-companion.<tailnet>.ts.net

# Prikaz vremena: otvorena odluka N3 (Europe/Warsaw prema specifikaciji ili Europe/Zagreb)
TZ=Europe/Warsaw

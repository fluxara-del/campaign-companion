// Prisma ORM 7 (zaključano na 7.10.1).
// Prisma posjeduje shemu i migracije. Kritični put pisanja ide kroz better-sqlite3
// (BEGIN IMMEDIATE), vidi docs/adr/0006-put-pisanja-sqlite.md.
// Vremena se spremaju kao ISO 8601 UTC tekst (String) radi jednakog zapisa iz oba sloja.
// CHECK ograničenja i triggeri za nepromjenjivost dodani su ručno u SQL migracije
// (Prisma ih ne modelira); `prisma migrate diff` ih ne prijavljuje kao odstupanje.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Ključ/vrijednost metapodaci instance. Nije domenski podatak kampanje.
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Campaign {
  id             String @id
  name           String
  rulesetId      String @default("dnd5e-2024")
  rulesetVersion String
  /// Povećava se točno jednom po potvrđenom batchu.
  stateVersion   Int    @default(0)
  /// Najveći `seq` događaja u kampanji.
  lastEventSeq   Int    @default(0)
  createdAt      String

  members    Member[]
  characters Character[]
  pools      ResourcePool[]
  wallets    Wallet[]
  receipts   BatchReceipt[]
  events     DomainEvent[]
  journal    JournalEntry[]
  baselines  CampaignBaseline[]
  imports    ImportBatch[]
  legacy     LegacyEvent[]
  items      ItemInstance[]
  entities   EntityRecord[]
  documents  SourceDocument[]
}

model Member {
  campaignId String
  actorId    String
  /// owner | player | ai_service | viewer
  role       String
  createdAt  String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@id([campaignId, actorId])
}

model Character {
  id         String @id
  campaignId String
  name       String
  hpCurrent  Int
  /// null = nepoznato
  hpMax      Int?
  hpTemp     Int    @default(0)

  campaign Campaign          @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  pools    ResourcePool[]
  wallets  Wallet[]
  profile  CharacterProfile?

  @@unique([campaignId, id])
}

model ResourcePool {
  id             String  @id
  campaignId     String
  characterId    String
  resourceKey    String
  /// null = nepoznato (ne 0)
  current        Int?
  /// null = nepoznato
  max            Int?
  /// short_rest | long_rest | manual | null (nepoznato)
  rechargePolicy String?

  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  character Character @relation(fields: [campaignId, characterId], references: [campaignId, id], onDelete: Restrict)

  @@unique([characterId, resourceKey])
  @@unique([campaignId, id])
}

model Wallet {
  id               String  @id
  campaignId       String
  /// null = skupni/namjenski fond bez vlasnika lika
  ownerCharacterId String?
  /// personal | group_dedicated
  purpose          String
  label            String
  /// Valuta; iznos je u najmanjoj jedinici (cp).
  currency         String  @default("cp")
  /// null = nepoznato
  amountMinor      Int?

  campaign Campaign   @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  owner    Character? @relation(fields: [campaignId, ownerCharacterId], references: [campaignId, id], onDelete: Restrict)

  @@unique([campaignId, id])
}

model BatchReceipt {
  campaignId         String
  batchId            String
  requestHash        String
  actorId            String
  stateVersionBefore Int
  stateVersionAfter  Int
  firstSeq           Int
  lastSeq            Int
  responseJson       String
  committedAt        String

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  commands CommandIndex[]
  events   DomainEvent[]
  journal  JournalEntry[]

  @@id([campaignId, batchId])
  @@unique([campaignId, stateVersionAfter])
}

model CommandIndex {
  campaignId String
  commandId  String
  batchId    String
  position   Int

  receipt BatchReceipt @relation(fields: [campaignId, batchId], references: [campaignId, batchId], onDelete: Restrict)

  @@id([campaignId, commandId])
  @@unique([campaignId, batchId, position])
}

model DomainEvent {
  id            String  @id
  campaignId    String
  seq           Int
  batchId       String
  commandId     String
  type          String
  schemaVersion Int
  payloadJson   String
  /// player | dm_manual | ai_service | import | system
  actorKind     String
  actorId       String
  sourceRef     String?
  occurredAt    String
  worldTime     String?
  /// player | dm | shared
  visibility    String
  knowledgeKind String?

  campaign Campaign           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  receipt  BatchReceipt       @relation(fields: [campaignId, batchId], references: [campaignId, batchId], onDelete: Restrict)
  journal  JournalEventLink[]

  @@unique([campaignId, seq])
  @@unique([campaignId, id])
  @@index([campaignId, batchId])
}

model JournalEntry {
  id         String  @id
  campaignId String
  batchId    String?
  /// manual | projection | summary
  kind       String
  title      String?
  text       String
  /// player | dm | shared
  visibility String
  revision   Int     @default(1)
  createdAt  String

  campaign Campaign           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  receipt  BatchReceipt?      @relation(fields: [campaignId, batchId], references: [campaignId, batchId], onDelete: Restrict)
  events   JournalEventLink[]

  @@unique([campaignId, id])
  @@index([campaignId, createdAt])
}

/// Veza dnevnika i događaja; oba moraju pripadati istoj kampanji (složeni strani ključevi).
model JournalEventLink {
  campaignId     String
  journalEntryId String
  eventId        String

  entry JournalEntry @relation(fields: [campaignId, journalEntryId], references: [campaignId, id], onDelete: Restrict)
  event DomainEvent  @relation(fields: [campaignId, eventId], references: [campaignId, id], onDelete: Restrict)

  @@id([journalEntryId, eventId])
}

/// Provjereni početni snapshot od kojeg se jamči deterministički replay.
model CampaignBaseline {
  id           String @id
  campaignId   String
  seq          Int
  stateVersion Int
  snapshotJson String
  snapshotHash String
  /// synthetic | import
  source       String
  createdAt    String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@unique([campaignId, seq])
}

// ---------------------------------------------------------------------------
// Faza 2: uvoz postojeće kampanje. Sve tablice su vezane na kampanju složenim
// ključevima; legacy zapisi i izvorni dokumenti su append-only (triggeri u migraciji).
// ---------------------------------------------------------------------------

/// Jedan probni ili prihvaćeni uvoz: manifest izvornih datoteka i izvještaj.
model ImportBatch {
  id                 String  @id
  campaignId         String
  /// trial | accepted (prihvaćanje je zasebna buduća odluka vlasnika)
  status             String
  importerVersion    String
  sourceManifestJson String
  sourceManifestHash String
  contentHash        String
  legacyStateVersion Int?
  legacyLastEventId  String?
  reportJson         String
  createdAt          String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@unique([campaignId, id])
}

/// Legacy događaj iz events.jsonl: izvorni JSON i hash, bez izmišljenih mehaničkih delta.
model LegacyEvent {
  campaignId         String
  legacyId           String
  position           Int
  sessionId          String?
  legacyStateVersion Int?
  type               String?
  title              String?
  rawJson            String
  rawSha256          String
  sourceFile         String
  sourceLine         Int
  importBatchId      String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@id([campaignId, legacyId])
  @@unique([campaignId, position])
}

/// Primjerak predmeta. Vlasnik, držatelj i lokacija su odvojeni; null = nepoznato.
/// quantity: null = nepoznato (npr. predmet izvan inventara bez navedene količine)
model ItemInstance {
  id              String   @id
  campaignId      String
  name            String
  quantity        Int?
  /// Legacy ID vlasnika (lik ili NPC); null = nepoznat vlasnik
  ownerRef        String?
  /// Legacy ID trenutačnog držatelja; null = nepoznato
  holderRef       String?
  location        String?
  containerItemId String?
  /// null = nepoznato
  equipped        Boolean?
  attuned         Boolean?
  massLbTenths    Int?
  stateNote       String?
  attributesJson  String
  sourceRef       String

  campaign  Campaign       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  container ItemInstance?  @relation("ItemContainer", fields: [campaignId, containerItemId], references: [campaignId, id], onDelete: Restrict)
  contents  ItemInstance[] @relation("ItemContainer")

  @@unique([campaignId, id])
}

/// Statički profil lika iz izvora (atributi, vještine, čarolije, osobine) dok ga Faza 3 ne modelira.
model CharacterProfile {
  campaignId  String
  characterId String
  profileJson String
  sourceRef   String

  character Character @relation(fields: [campaignId, characterId], references: [campaignId, id], onDelete: Restrict)

  @@id([campaignId, characterId])
}

/// NPC, zadatak, odnos ili lokacija iz registara. Vrsta znanja se klasificira kasnije.
model EntityRecord {
  id         String
  campaignId String
  /// npc | quest | relationship
  kind       String
  name       String
  status     String?
  /// player | dm | shared
  visibility String
  dataJson   String
  sourceRef  String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@id([campaignId, kind, id])
}

/// Izvorni dokument (sesija, handoff, kanon) kao prilog, s hashom.
model SourceDocument {
  campaignId    String
  path          String
  /// session | handoff | world | other
  kind          String
  sha256        String
  content       String
  importBatchId String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@id([campaignId, path])
}

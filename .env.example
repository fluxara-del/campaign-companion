# Lokalni razvoj. Kopiraj u .env (koji je u .gitignore) i popuni.
# Razvojna baza je uvijek lokalna datoteka u ./data/ (ignorirana u Gitu).
DATABASE_URL="file:./data/dev.db"
BACKUP_DIR="./backups"

# AI provider (Faza 5): openai | anthropic | none
AI_PROVIDER="none"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_MODEL=""

# Prikaz vremena (spremanje je uvijek UTC); otvorena odluka N3: Europe/Warsaw (spec) ili Europe/Zagreb
TZ="Europe/Warsaw"

# Lokalni način bez prijave dok se ne odluči O5. ISKLJUČEN po zadanom: bez njega API vraća 503.
# Uključi ga samo na vlastitom računalu i samo uz `npm run dev` / `npm start`, koji vežu
# aplikaciju na 127.0.0.1 i odbijaju pokretanje uz ne-loopback adresu. Nikad u produkciji
# ni na adresi dostupnoj iz mreže. KDZ_LISTEN_HOST ne postavljati ovdje (postavlja ga pokretač).
# KDZ_AUTH_MODE="local-owner"
# KDZ_LOCAL_OWNER_ACTOR="owner"
